# Railway MySQL + Cloudflare R2 (new Ink API)
PORT=3000

# Local Docker MySQL (already imported inkisrael_app dump)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=user
DB_PASS=password
DB_NAME=inkisrael_app

# After Railway MySQL is created, replace with Railway values:
# DB_HOST=xxxxx.railway.app
# DB_PORT=3306
# DB_USER=root
# DB_PASS=...
# DB_NAME=railway

# Cloudflare R2 (leave empty until bucket is created)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=ink-media
# Public base URL from R2 bucket settings (r2.dev or custom domain). Leave empty until ready.
R2_PUBLIC_BASE=

# App
APP_TOKEN=123456
CORS_ORIGIN=*
