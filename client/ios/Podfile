platform :ios, '15.0'

# CocoaPods analytics sends network stats synchronously affecting flutter build latency.
ENV['COCOAPODS_DISABLE_STATS'] = 'true'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. If you're running pod install manually, make sure flutter pub get is executed first"
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found in #{generated_xcode_build_settings_path}. Try deleting Generated.xcconfig, then run flutter pub get"
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)
require 'fileutils'

flutter_ios_podfile_setup

# Meta's CocoaPods FBAudienceNetwork zip is often incomplete on CI.
# flutter build ipa re-runs pod install, so repair must live in post_install.
def repair_fb_audience_network!
  pods_root = File.join(__dir__, 'Pods', 'FBAudienceNetwork')
  return unless Dir.exist?(pods_root)

  xc = File.join(pods_root, 'Static', 'FBAudienceNetwork.xcframework')
  info = File.join(xc, 'Info.plist')
  return if File.exist?(info)

  puts '>>> Repairing incomplete FBAudienceNetwork.xcframework'
  zip = '/tmp/FBAudienceNetwork-6.20.1.zip'
  extract = '/tmp/FAN_extract'
  url = 'https://developers.facebook.com/resources/FBAudienceNetwork-6.20.1.zip'

  FileUtils.rm_rf(extract)
  FileUtils.mkdir_p(extract)

  ok = system('curl', '-fL', '--retry', '3', '--retry-delay', '2', '-o', zip, url)
  raise 'Failed to download FBAudienceNetwork zip' unless ok

  ok = system('unzip', '-qo', zip, '-d', extract)
  raise 'Failed to unzip FBAudienceNetwork' unless ok

  static_src = File.join(extract, 'Static', 'FBAudienceNetwork.xcframework')
  if File.directory?(static_src)
    FileUtils.rm_rf(File.join(pods_root, 'Static'))
    FileUtils.cp_r(File.join(extract, 'Static'), File.join(pods_root, 'Static'))
  else
    src = Dir.glob(File.join(extract, '**', 'FBAudienceNetwork.xcframework')).first
    raise 'FBAudienceNetwork.xcframework missing inside downloaded zip' if src.nil?
    FileUtils.mkdir_p(File.join(pods_root, 'Static'))
    FileUtils.rm_rf(xc)
    FileUtils.cp_r(src, File.join(pods_root, 'Static', 'FBAudienceNetwork.xcframework'))
  end

  raise 'FBAudienceNetwork repair failed (Info.plist still missing)' unless File.exist?(info)
  puts '>>> FBAudienceNetwork repair OK'
end

target 'Runner' do
  # Pin Facebook SDK pieces that facebook_app_events needs, without floating onto
  # a broken Audience Network CocoaPods layout when possible.
  pod 'FBSDKCoreKit', '18.0.0'
  pod 'FBAEMKit', '18.0.0'
  pod 'FBSDKCoreKit_Basics', '18.0.0'

  use_frameworks!
  use_modular_headers!

  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)
    target.build_configurations.each do |config|
      config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '15.0'
      config.build_settings['SWIFT_VERSION'] = '5'
      config.build_settings['GCC_PREPROCESSOR_DEFINITIONS'] ||= [
        '$(inherited)',
        'PERMISSION_CAMERA=1',
        'PERMISSION_NOTIFICATIONS=1',
        'PERMISSION_PHOTOS=1',
        'PERMISSION_LOCATION=1',
      ]
    end
    if target.name == 'BoringSSL-GRPC'
      target.source_build_phase.files.each do |file|
        if file.settings && file.settings['COMPILER_FLAGS']
          flags = file.settings['COMPILER_FLAGS'].split
          flags.reject! { |flag| flag == '-GCC_WARN_INHIBIT_ALL_WARNINGS' }
          file.settings['COMPILER_FLAGS'] = flags.join(' ')
        end
      end
    end
  end

  repair_fb_audience_network!
end
